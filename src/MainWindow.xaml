<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video Cutter" Width="1100" Height="780" MinWidth="760" MinHeight="560"
        Background="#15171C" Foreground="#E6E8EE" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" AllowDrop="True" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#1E2128"/>
    <SolidColorBrush x:Key="Border" Color="#2C3039"/>
    <SolidColorBrush x:Key="Muted" Color="#8C93A3"/>
    <SolidColorBrush x:Key="Accent" Color="#4F8CFF"/>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="Background" Value="#2A2E37"/>
      <Setter Property="BorderBrush" Value="#353A45"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="3,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#363B47"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="#424855"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#4F8CFF"/>
      <Setter Property="BorderBrush" Value="#4F8CFF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Icon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#111318"/>
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="BorderBrush" Value="#353A45"/>
      <Setter Property="CaretBrush" Value="#E6E8EE"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#4F8CFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="Margin" Value="0,0,18,0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#C9CED8"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="#111318" BorderBrush="#353A45" BorderThickness="1" CornerRadius="6" Padding="11,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2A2E37"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#4F8CFF"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#4F8CFF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="#4F8CFF"/>
      <Setter Property="Background" Value="#111318"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="6"/>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top bar -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="BtnOpen" Style="{StaticResource Primary}" Margin="0,0,12,0" ToolTip="Open a video (Ctrl+O). You can also drag a file onto the window.">
        <StackPanel Orientation="Horizontal">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="Open video"/>
        </StackPanel>
      </Button>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="TxtFile" Text="No video open" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="TxtInfo" Text="Open or drop a video file to start." Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Grid>

    <!-- Video -->
    <Border Grid.Row="1" Background="Black" CornerRadius="8" ClipToBounds="True" x:Name="VideoArea">
      <Grid>
        <!-- loop preview: snapshot of the last frame, shown behind the players while the next cycle starts -->
        <Image x:Name="HoldImage" Stretch="Uniform" Visibility="Collapsed" Panel.ZIndex="5"/>
        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform" IsMuted="False"/>
        <!-- second player: waits at START so loop preview can jump/crossfade without a seek stall -->
        <MediaElement x:Name="Player2" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform" Opacity="0"/>
        <!-- frame-exact seam preview: plays a short clip rendered by FFmpeg -->
        <MediaElement x:Name="SeamPlayer" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform"
                      Visibility="Collapsed" Panel.ZIndex="6"/>
        <Image x:Name="FrameImage" Stretch="Uniform" Visibility="Collapsed" RenderOptions.BitmapScalingMode="LowQuality"/>
        <StackPanel x:Name="DropHint" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE714;" FontSize="48" Foreground="#3A3F4B" HorizontalAlignment="Center"/>
          <TextBlock Text="Drop a video here" Foreground="#5D6475" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
        <Border x:Name="PreviewBadge" Visibility="Collapsed" Background="#CC000000" CornerRadius="4" Padding="8,3"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Panel.ZIndex="10">
          <TextBlock x:Name="PreviewBadgeText" Foreground="#E0B050" FontSize="11" Text="Still-frame preview"/>
        </Border>
      </Grid>
    </Border>

    <!-- Transport -->
    <Grid Grid.Row="2" Margin="0,10,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="TxtPos" Text="00:00:00.000" FontFamily="Consolas" FontSize="18"/>
        <TextBlock x:Name="TxtDur" Text=" / 00:00:00.000" FontFamily="Consolas" FontSize="14" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnPrevKey" Style="{StaticResource Icon}" Content="&#xE892;" ToolTip="Previous keyframe (Ctrl+Left)"/>
        <Button x:Name="BtnPrevFrame" Style="{StaticResource Icon}" Content="&#xE76B;" ToolTip="Back 1 frame (Left) — Shift+Left = 1 second"/>
        <Button x:Name="BtnPlay" Style="{StaticResource Icon}" Content="&#xE768;" Width="52" ToolTip="Play / Pause (Space)"/>
        <Button x:Name="BtnNextFrame" Style="{StaticResource Icon}" Content="&#xE76C;" ToolTip="Forward 1 frame (Right) — Shift+Right = 1 second"/>
        <Button x:Name="BtnNextKey" Style="{StaticResource Icon}" Content="&#xE893;" ToolTip="Next keyframe (Ctrl+Right)"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                    ToolTip="Playback speed. Also used by Frame-accurate and Looped to exports (audio keeps its pitch). Double-click to reset to 1×. Keys: [ and ]">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEC4A;" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Slider x:Name="SpeedSlider" Width="110" Minimum="0" Maximum="10" Value="4" TickFrequency="1" IsSnapToTickEnabled="True"
                  VerticalAlignment="Center" Focusable="False"/>
          <TextBlock x:Name="TxtSpeed" Text="1×" FontFamily="Consolas" Width="44" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="BtnPlaySel" ToolTip="Play only the selected part (P)">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
            <TextBlock Text="Play selection"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnMute" Style="{StaticResource Icon}" Content="&#xE767;" ToolTip="Mute / unmute (M)"/>
      </StackPanel>
    </Grid>

    <!-- Timeline -->
    <Border Grid.Row="3" x:Name="TimelineHost" Height="64" Background="{StaticResource Panel}" CornerRadius="8" Padding="0"/>

    <!-- In / Out -->
    <Border Grid.Row="4" Background="{StaticResource Panel}" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
      <WrapPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,2,24,2">
          <TextBlock Text="START" Foreground="#4FD18B" FontWeight="SemiBold" VerticalAlignment="Center" Width="46"/>
          <TextBox x:Name="TbIn" Width="128" Text="00:00:00.000" ToolTip="Type a time (e.g. 1:23.5 or 00:01:23.500) and press Enter"/>
          <Button x:Name="BtnSetIn" Margin="6,0,0,0" ToolTip="Set start to the current position (I)">Set to playhead  [I]</Button>
          <Button x:Name="BtnGoIn" Style="{StaticResource Icon}" Content="&#xE8AD;" ToolTip="Jump to start point"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,24,2">
          <TextBlock Text="END" Foreground="#FF6B6B" FontWeight="SemiBold" VerticalAlignment="Center" Width="36"/>
          <TextBox x:Name="TbOut" Width="128" Text="00:00:00.000" ToolTip="Type a time and press Enter"/>
          <Button x:Name="BtnSetOut" Margin="6,0,0,0" ToolTip="Set end to the current position (O)">Set to playhead  [O]</Button>
          <Button x:Name="BtnGoOut" Style="{StaticResource Icon}" Content="&#xE8AD;" ToolTip="Jump to end point"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,24,2" VerticalAlignment="Center">
          <TextBlock Text="Length " Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          <TextBlock x:Name="TxtLen" Text="00:00:00.000" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,2" VerticalAlignment="Center"
                    ToolTip="How the selection looks when it repeats. The 'Looped to' export uses the same style.">
          <TextBlock Text="LOOP PREVIEW" Foreground="#4F8CFF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <RadioButton x:Name="RbLoopOff" Style="{StaticResource Seg}" GroupName="loop" IsChecked="True" Content="Off" ToolTip="Play selection stops at END (L cycles loop modes). A looped export uses a plain loop."/>
          <RadioButton x:Name="RbLoopPlain" Style="{StaticResource Seg}" GroupName="loop" Content="Loop" ToolTip="END jumps straight back to START - shows whether the cut loops seamlessly"/>
          <RadioButton x:Name="RbLoopFade" Style="{StaticResource Seg}" GroupName="loop" Content="Crossfade loop" ToolTip="The end blends into the start over the fade time"/>
          <RadioButton x:Name="RbLoopMirror" Style="{StaticResource Seg}" GroupName="loop" Content="Mirror"
                       ToolTip="Forward, then backward, then forward again: the end turns back into the start, so there is never a jump. Previewed by rendering (about a second)."/>
          <TextBox x:Name="TbFade" Width="54" Text="1.0" FontSize="13" Margin="4,0,0,0" ToolTip="Crossfade length in seconds - press Enter"/>
          <TextBlock Text="s" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,8,0"/>
          <Button x:Name="BtnSeam" ToolTip="Frame-exact preview of the loop point: 2 s before END, the jump or crossfade, 2 s after START - rendered exactly like the export (S)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8EE;" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
              <TextBlock Text="Play seam"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- Export -->
    <Border Grid.Row="5" Background="{StaticResource Panel}" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <WrapPanel Orientation="Horizontal">
            <RadioButton x:Name="RbCopy" IsChecked="True" GroupName="mode" Margin="0,4,18,4">
              <TextBlock><Run FontWeight="SemiBold" Text="Fast lossless"/><Run Foreground="#8C93A3" Text="  (copy, no re-encode)"/></TextBlock>
            </RadioButton>
            <RadioButton x:Name="RbExact" GroupName="mode" Margin="0,4,18,4">
              <TextBlock><Run FontWeight="SemiBold" Text="Frame-accurate"/><Run Foreground="#8C93A3" Text="  (re-encode to match source)"/></TextBlock>
            </RadioButton>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
              <RadioButton x:Name="RbLoopExport" GroupName="mode" Margin="0,4,8,4"
                           ToolTip="Repeat the selection until the length you type. Plain or crossfade follows the LOOP PREVIEW setting.">
                <TextBlock FontWeight="SemiBold" Text="Looped to"/>
              </RadioButton>
              <TextBox x:Name="TbLoopLen" Width="122" Text="00:10:00" FontSize="13"
                       ToolTip="Total length of the looped video, e.g. 10:00 or 1:00:00 - press Enter"/>
              <Button x:Name="BtnOneCycle" Margin="6,0,0,0" Padding="9,5"
                      ToolTip="Exactly one loop cycle: a file that repeats seamlessly (FFmpeg -stream_loop, OBS repeat, video editors)">1 cycle</Button>
              <CheckBox x:Name="CbWholeCycles" IsChecked="True" Foreground="#C9CED8" VerticalAlignment="Center" Margin="8,0,0,0" Focusable="False"
                        ToolTip="Round the length to whole loop cycles, so the exported file itself also loops seamlessly when repeated">Whole cycles</CheckBox>
            </StackPanel>
          </WrapPanel>
          <TextBlock x:Name="TxtModeNote" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Value="0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="Ready" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,0,0,0" MinWidth="120"/>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button x:Name="BtnCancel" Visibility="Collapsed">Cancel</Button>
          <Button x:Name="BtnShow" Visibility="Collapsed" ToolTip="Show the exported file in Explorer">Show file</Button>
          <Button x:Name="BtnExport" Style="{StaticResource Primary}" Padding="20,9" ToolTip="Export the selected part (Ctrl+E)">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C6;" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Export cut"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
